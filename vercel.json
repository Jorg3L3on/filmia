{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "enabled": true
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/cron/watch-providers",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/tonight-picks",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/tonight-recos",
      "schedule": "45 9 * * *"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "enabled": false
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "sandbox": false
    }
  },
  "ignoreCommand": "exit 0",
  "crons": [
    {
      "path": "/api/cron/watch-providers",
      "schedule": "0 9 * * *"
    }
  ]
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TitleKind {
  MOVIE
  SERIES
}

enum Platform {
  NETFLIX
  PRIME
  MAX
  DISNEY
  CLARO
  APPLE
  MUBI
}

enum ListKind {
  COLLECTION
  WATCHLIST
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  streamingPlatforms Json     @default("[]")
  createdAt          DateTime @default(now())
  titles             Title[]
  lists              List[]
  tags               Tag[]

  @@index([email])
}

model Title {
  id                      String     @id @default(cuid())
  userId                  String
  name                    String
  originalName            String?
  kind                    TitleKind
  year                    Int?
  rating                  Int?
  review                  String?    @db.Text
  platform                Platform?
  watchedAt               DateTime?
  tmdbId                  Int?
  posterPath              String?
  imdbId                  String?
  imdbRating              Float?
  watchProvidersMx        Json?
  watchProvidersFetchedAt DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags                    TitleTag[]
  listItems               ListItem[]

  @@index([userId])
  @@index([kind])
  @@index([rating])
  @@index([name])
  @@index([tmdbId])
  @@index([imdbId])
}

model Tag {
  id        String     @id @default(cuid())
  userId    String
  name      String
  slug      String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  titles    TitleTag[]

  @@unique([userId, slug])
  @@index([userId])
}

model TitleTag {
  titleId String
  tagId   String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([titleId, tagId])
}

model List {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  kind        ListKind   @default(COLLECTION)
  slug        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([kind])
}

model ListItem {
  listId    String
  titleId   String
  position  Int      @default(0)
  queueNote String?
  addedAt   DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([listId, titleId])
  @@index([listId, position])
}

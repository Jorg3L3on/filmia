generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TitleKind {
  MOVIE
  SERIES
}

enum Platform {
  NETFLIX
  PRIME
  MAX
  DISNEY
  CLARO
}

model Title {
  id           String     @id @default(cuid())
  name         String
  originalName String?
  kind         TitleKind
  year         Int?
  rating       Int?
  review       String?    @db.Text
  platform     Platform?
  watchedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tags         TitleTag[]
  listItems    ListItem[]

  @@index([kind])
  @@index([rating])
  @@index([name])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  titles    TitleTag[]
}

model TitleTag {
  titleId String
  tagId   String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([titleId, tagId])
}

model List {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       ListItem[]
}

model ListItem {
  listId   String
  titleId  String
  position Int      @default(0)
  addedAt  DateTime @default(now())
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  title    Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([listId, titleId])
  @@index([listId, position])
}

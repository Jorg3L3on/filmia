    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "16.3.8",

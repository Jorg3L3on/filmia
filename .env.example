# Copia este archivo a .env y pega las URLs del proyecto Neon `filmia`.
# Nunca commitees .env ni secretos reales.

# Conexión pooled (hostname con -pooler): la usa la app Next.js / Workers en runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión directa (sin -pooler): Prisma CLI (migrate / seed). No hace falta para `prisma generate`.
# No es necesaria en Cloudflare Workers; solo en CI/local para migraciones.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth (JWT). Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la app (obligatoria en Cloudflare Workers).
# Local: http://localhost:3000
# Cloudflare: https://filmia.<tu-subdominio>.workers.dev (o tu dominio custom)
AUTH_URL="http://localhost:3000"
# Alias aceptado por Auth.js:
# NEXTAUTH_URL="http://localhost:3000"

# Posters (TMDB, tier gratuito): https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Ratings IMDb vía OMDb (1000 req/día gratis): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=""

# --- Cloudflare (Workers) ---
# Para preview local en runtime Workers: copia .dev.vars.example → .dev.vars
# y pega las mismas variables (sin DATABASE_URL_UNPOOLED salvo que corras migrate ahí).
#
# Secretos en producción (wrangler secret put NOMBRE):
#   DATABASE_URL, AUTH_SECRET, TMDB_API_KEY, OMDB_API_KEY
# Variables públicas (wrangler.toml / dashboard → Variables):
#   AUTH_URL (o NEXTAUTH_URL) = URL del Worker desplegado
#
# Migraciones: siguen en CI/local contra Neon, no dentro del Worker:
#   DATABASE_URL_UNPOOLED=... npx prisma migrate deploy

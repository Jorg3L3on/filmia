# Copia este archivo a .env y pega las URLs del proyecto Neon `filmia`.
# Nunca commitees .env ni secretos reales.

# Conexión pooled (hostname con -pooler): la usa la app en runtime (Vercel / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión directa (sin -pooler): drizzle-kit migrate / scripts CLI
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la app. Local: http://localhost:3000
# En Vercel se infiere; puedes fijarla si hace falta.
AUTH_URL="http://localhost:3000"

# Acceso con Google (opcional; sin estas dos variables el botón no aparece).
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizada: <AUTH_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Posters (TMDB, tier gratuito): https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Ratings IMDb vía OMDb (1000 req/día gratis): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=""

# Vercel Cron (refresco diario de «Disponible en MX»). Genera uno con: openssl rand -base64 32
CRON_SECRET=""

# Avisos «Llegó a tu plataforma» (Web Push, opcional; sin las llaves el switch de Perfil no aparece).
# Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto para los servicios de push: mailto: o https público (Apple rechaza localhost).
VAPID_SUBJECT="mailto:tu-correo@example.com"

# Conector MCP (FIL-I20): Claude, ChatGPT, Grok y Cursor. Solo "1" lo enciende; vacío o
# cualquier otro valor deja /api/mcp, /mcp, /api/oauth/* y /.well-known/* en 404.
# El issuer OAuth y la URL del recurso salen de AUTH_URL (nunca del header Host).
MCP_ENABLED=""

# Solo desarrollo y pruebas: "1" hace que la app hable con un Postgres local (DATABASE_URL a
# localhost) en lugar de Neon. Nunca en Vercel.
# FILMIA_LOCAL_PG="1"

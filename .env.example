# Copia este archivo a .env y pega las URLs del proyecto Neon `filmia`.
# Nunca commitees .env ni secretos reales.

# Conexión pooled (hostname con -pooler): la usa la app Next.js
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión directa (sin -pooler): Prisma CLI (migrate / seed). No hace falta para `prisma generate`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
